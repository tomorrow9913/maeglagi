{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maeglagi.local/schemas/context.schema.json",
  "title": "ContextSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "subject", "summary", "current_state", "open_issues", "decisions", "next_actions", "updated_at", "source_refs"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "name"],
      "properties": {
        "type": { "enum": ["workspace", "project"] },
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "current_state": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "open_issues": { "type": "array", "items": { "type": "string", "format": "uuid" }, "uniqueItems": true },
    "decisions": { "type": "array", "items": { "type": "string", "format": "uuid" }, "uniqueItems": true },
    "next_actions": { "type": "array", "items": { "type": "string", "format": "uuid" }, "uniqueItems": true },
    "updated_at": { "type": "string", "format": "date-time" },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/sourceRef" }
    }
  }
}

