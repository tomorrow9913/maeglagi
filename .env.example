APP_ENV=local
APP_SECRET_KEY=replace-with-at-least-32-random-characters
# Supabase Dashboard > Connect > Session pooler. SQLAlchemy asyncpg 형식을 사용합니다.
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_STORAGE_BUCKET=sources
CORS_ORIGINS=["http://localhost:3000"]
LLM_PROVIDER=mock
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_USE_MOCKS=true
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
