APP_ENV=local
APP_SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql+asyncpg://maeglagi:maeglagi@localhost:5432/maeglagi
DATABASE_AUTO_CREATE=true
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=maeglagi
S3_SECRET_KEY=maeglagi-local-secret
S3_BUCKET=maeglagi-sources
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=maeglagi-local-password
CORS_ORIGINS=["http://localhost:3000"]
LLM_PROVIDER=mock
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_USE_MOCKS=true

# ZITADEL self-hosting. Generate each secret with `openssl rand -base64 32`.
# ZITADEL_MASTERKEY must be exactly 32 ASCII characters and cannot be rotated
# after the first initialization without a documented migration.
ZITADEL_VERSION=v4.16.0
ZITADEL_MASTERKEY=change-me-32-characters-long-000
ZITADEL_DATABASE_PASSWORD=replace-with-a-random-database-password
ZITADEL_ADMIN_USERNAME=zitadel-admin
ZITADEL_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Create one OIDC Web application in http://localhost:8081 after first startup.
# Redirect URI: http://localhost:3000/api/auth/callback/zitadel
# Post logout URI: http://localhost:3000
AUTH_SECRET=replace-with-another-random-32-byte-secret
AUTH_ZITADEL_ISSUER=http://localhost:8081
AUTH_ZITADEL_ID=replace-with-zitadel-oidc-client-id
AUTH_ZITADEL_SECRET=replace-with-zitadel-oidc-client-secret

# FastAPI validates the same access token and maps its subject to an internal UUID.
AUTH_ENABLED=true
AUTH_PROVIDER=zitadel
AUTH_ISSUER=http://localhost:8081
# Optional. Set to the API project/resource audience if ZITADEL is configured to add it.
AUTH_AUDIENCE=
