APP_ENV=local
APP_SECRET_KEY=replace-with-at-least-32-random-characters
# Supabase Dashboard > Connect > Session pooler. SQLAlchemy asyncpg 형식을 사용합니다.
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Worker가 private Storage 원본을 읽을 때만 사용합니다. 프론트에는 절대 노출하지 않습니다.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me
SUPABASE_STORAGE_BUCKET=sources
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false
NEO4J_URI=neo4j+s://replace-me.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-me
CORS_ORIGINS=["http://localhost:3000"]
LLM_PROVIDER=mock
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
RATE_LIMIT=120/minute
# 여러 API instance에서는 async+redis://... 또는 redis://...를 사용하세요.
RATE_LIMIT_STORAGE_URI=memory://
LOG_LEVEL=INFO
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_USE_MOCKS=true
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
