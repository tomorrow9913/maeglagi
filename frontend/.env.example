# 프론트 전용 환경변수입니다. frontend/에서 `cp .env.example .env.local` 후 사용하세요.
# Next.js의 Root Directory가 frontend이면 저장소 루트의 .env는 읽지 않습니다.

# FastAPI 공개 주소 + /api/v1. 끝에 /를 붙이지 마세요.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# 실 API 연결에는 정확히 false를 사용하세요. 다른 값이나 미설정은 mock입니다.
NEXT_PUBLIC_USE_MOCKS=true

# 실 API에서는 둘 다 필요하며, 백엔드 SUPABASE_URL/공개 키와 같은 프로젝트여야 합니다.
# 공개 키만 여기에 넣으세요. 서비스 역할 키와 provider 비밀 키는 NEXT_PUBLIC_에 넣지 마세요.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
