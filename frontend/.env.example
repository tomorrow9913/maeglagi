# 프론트 전용 환경변수입니다. `cp .env.example .env.local` 후 사용하세요.
# 루트의 .env는 백엔드용이고 Next.js는 읽지 않습니다.

# FastAPI API 베이스 URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# true면 in-memory mock, false면 위 URL의 실 API를 호출합니다.
NEXT_PUBLIC_USE_MOCKS=true

# Supabase 인증. 둘 다 없으면 로그인 기능이 꺼진 채로 동작합니다.
# Supabase Dashboard > Project Settings > API 에서 확인합니다.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
