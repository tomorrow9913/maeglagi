# Copy to .env.docker, fill in real values, and keep that file private.
# Supabase Auth, Storage and PostgreSQL are external, even with all local profiles enabled.
APP_ENV=production
# Self-hosted users can register private/Docker Ollama endpoints in account connection settings.
# Public multi-tenant deployments must use saas (public HTTPS endpoints by default).
DEPLOYMENT_MODE=self_hosted
APP_SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me
SUPABASE_STORAGE_BUCKET=sources

# postgres runs durable jobs inside the API; start only frontend and api.
# celery uses the optional Redis/worker deployment below.
PROCESSING_EXECUTOR=celery
# Set false on the API when a separate pg-worker reads the PostgreSQL queue.
PG_EXECUTOR_ENABLED=true

# After migration and pgmq verification, enable source SSE on the API only.
# Defaults to DATABASE_URL when it is direct or session mode. Otherwise copy a
# separate direct/session URL; transaction pooler port 6543 cannot support LISTEN.
SOURCE_EVENTS_ENABLED=false
SOURCE_EVENTS_LISTENER_DATABASE_URL=

# API and worker must reach the same Redis instance and DB; their URLs may differ.
# URL-encode reserved password characters. Render can use the TLS address below.
REDIS_PASSWORD=replace-with-a-strong-redis-password
CELERY_BROKER_URL=redis://:replace-with-a-strong-redis-password@redis:6379/0
REDIS_PORT=6379
# Optional direct Redis TLS for a remote Render API. Default listener is disabled.
# Mount a host directory containing fullchain.pem, privkey.pem, ca.crt read-only.
REDIS_TLS_ENABLED=false
REDIS_TLS_CERT_DIR=./docker/redis/certs
REDIS_TLS_BIND_ADDRESS=127.0.0.1
REDIS_TLS_PORT=6380

# Optional external Neo4j URI, or bolt://neo4j:7687 with --profile neo4j.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
# New Ollama connections are registered in the app and stored per account in DB.
# Optional fallback only for existing Ollama credentials without a stored URL.
OLLAMA_BASE_URL=
# SaaS administrators may explicitly permit exact private hosts; users cannot alter this policy.
OLLAMA_ALLOWED_PRIVATE_HOSTS=[]
LLM_PROVIDER=mock
# Existing DB-backed public demo workspace ID, when used.
DEMO_WORKSPACE_ID=

# Browser-facing addresses and publishable values are embedded in the Next.js build.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_USE_MOCKS=false
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
CORS_ORIGINS=["http://localhost:3000"]
# Optional exact API origin for a custom MCP domain; omit the /mcp path.
MAEGLAGI_MCP_PUBLIC_URL=
FRONTEND_PORT=3000
API_PORT=8000

RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT=120/minute
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
LOG_LEVEL=INFO
